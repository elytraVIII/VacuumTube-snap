{
    "name": "vacuumtube",
    "version": "2.0.0",
    "description": "YouTube for TV, on your PC",
    "main": "src/index.js",
    "scripts": {
        "test": "node --test",
        "start": "electron .",
        "build:snap": "electron-builder --linux snap"
    },
    "keywords": [
        "youtube",
        "leanback",
        "smart-tv",
        "electron",
        "snap"
    ],
    "author": "shy (shy@shy.rocks)",
    "license": "MIT",
    "build": {
        "appId": "rocks.shy.VacuumTube",
        "productName": "VacuumTube",
        "artifactName": "VacuumTube-${version}-${arch}.${ext}",
        "linux": {
            "icon": "./assets/icon.png",
            "synopsis": "Watch and explore videos on YouTube",
            "category": "AudioVideo",
            "desktop": {
                "entry": {
                    "Name": "VacuumTube",
                    "Type": "Application",
                    "Categories": "AudioVideo;Video;Player;",
                    "Keywords": "YouTube;YT;TV;",
                    "StartupWMClass": "VacuumTube"
                }
            },
            "target": [
                {
                    "target": "snap",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "snapcraft": {
            "base": "core24",
            "core24": {
                "useLXD": true,
                "grade": "stable",
                "confinement": "strict",
                "summary": "YouTube for TV, on your PC",
                "plugs": [
                    "default",
                    "network",
                    "network-bind",
                    "audio-playback",
                    "audio-record",
                    "pulseaudio",
                    "camera",
                    {
                        "browser-sandbox": {
                            "interface": "browser-support",
                            "allow-sandbox": true
                        }
                    }
                ]
            }
        }
    },
    "devDependencies": {
        "electron": "^42.5.0",
        "electron-builder": "^26.0.12"
    },
    "dependencies": {
        "chokidar": "^5.0.0",
        "electron-updater": "^6.8.9",
        "minimist": "^1.2.8",
        "sponsorblock-api": "^0.2.4",
        "string-argv": "^0.3.2",
        "tseep": "^1.3.1"
    }
}
